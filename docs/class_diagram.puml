package "clients" {
  abstract class BaseHttpClient {
    #base_url : str
    #_client : httpx.Client            ' keep-alive 커넥션 풀
    #timeout / max_retries / verify
    +request(method, path, params, json, headers) : Any
    #_headers() : dict
    #_map_status(response) : Exception | None  ' 4xx/5xx → 도메인 예외(401=Unauthorized)
    +close()
  }
  class SlurmrestdClient {
    -api_version : str                 ' v0.0.43 고정
    -_tokens : SlurmTokenProvider
    #_headers()                        ' X-SLURM-USER-TOKEN + X-SLURM-USER-NAME
    -_call(method, group, path, as_user)  ' group = slurm | slurmdb
    .. slurmctld — /slurm/v0.0.43 ..
    +ping() / diag()
    +get_jobs() / get_job(id) / submit_job(spec, as_user)
    +cancel_job(id, as_user) / update_job(id, patch, as_user)
    +get_nodes() / get_node(name) / update_node(name, patch)
    +get_partitions()                  ' 조회만 — slurm.conf 영속화가 필요해 수정은 없다
    +get_reservations() / create_reservation(desc) / delete_reservation(name)
    .. slurmdbd — /slurmdb/v0.0.43 ..
    +get_accounts() / create_account(a, cluster_name) / delete_account(name)
    +get_associations() / add_user_association() / set_association_qos() / delete_association()
    +get_qos() / create_qos(q) / delete_qos(name)
    +get_accounting_jobs()             ' sacct
    +get_slurm_user(name)              ' 호출부 없음 — associations를 안 채워 준다(실측)
  }
  class AdClient {
    -settings : AdSettings
    +authenticate(username, password) : bool  ' 사용자 bind — 매번 새 연결
    +find_user(username) : AdUser | None      ' objectGUID 포함
    +list_users() : list[AdUser]              ' 허용 그룹 동기화(A-US-01)
    +test_connection() : bool
  }
  class AdSettings <<frozen>> {
    +ldaps_url / base_dn / bind_account / bind_password
    +allowed_group : str | None        ' memberOf 필터
    +id_attribute : str                ' sAMAccountName / uid
    +tls_verify : bool
    +ca_cert_file : str | None
  }
  class AdUser <<frozen>> {
    +object_guid / username / display_name / email
  }
  class ScpBillingClient {
    -_creds : ScpCredentials
    -_session() : scpv2.Session        ' costexplorer만 리전 없는 전역 호스트로 교정(실측)
    +usages(start_date, end_date) : list[dict]
    +tagged_resource_ids(key, value) : list[str]
  }
  class ScpCredentials <<frozen>> {
    +access_key / secret_key / region / environment
  }
  class SshTarget <<frozen>> {
    +host / port / account : str
    +private_key : str <<repr 제외>>
    +sftp_server : str
  }
  class LoginNodeClient {
    -target : SshTarget
    -known_hosts : str | None          ' 없으면 접속 거부 — 자동 수락은 중간자를 통과시킨다
    -_run_as(user, argv)               ' 제한 sudo impersonation
    -_sftp_as(user)                    ' sudo -u <본인> sftp-server
    +home_dir(user) / read_text(user, path) / makedirs(user, base, rel)
    +list_dir(user, path, allowed_roots) : (str, list[FileEntry])
    +make_dir() / create_file() / move() / remove() / upload() / open_read()
    +filesystems(user) / fairshare(user) / quota(user)   ' CLI 폴백
  }
  class FileEntry <<frozen>> {
    +name / is_dir / size / mtime / mode / uid / gid
  }
  class PtySession {
    +open() / read(size) / write(data) / resize(cols, rows) / close()
  }
  class TcpTunnel {
    ' SSH direct-tcpip — 목적지는 로그인 노드 sshd가 해석한다(ssh -L과 같은 원리)
    +open() / read(size) / write(data) / close()
    +dest() : (str, int)
  }
  class LocalPortForward {
    ' 백엔드 로컬 포트 → 로그인 노드 경유 → 워커 HTTP
    +open() / port() : int / alive() : bool / close()
  }
}

